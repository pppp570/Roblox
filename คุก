local ESPEnabled = false
local ESPs = {}

-- ฟังก์ชันสร้าง Highlight + Health Bar สำหรับผู้เล่น
local function CreateESP(player)
    if player == game.Players.LocalPlayer then return end
    if ESPs[player] then return end

    -- Highlight
    local hl = Instance.new("Highlight")
    hl.Name = "TeamESP"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- มองทะลุ
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Enabled = false
    hl.Parent = game.CoreGui

    -- Health Bar BillboardGui
    local BillboardGui = Instance.new("BillboardGui")
    BillboardGui.Name = "HealthBarESP"
    BillboardGui.Size = UDim2.new(4, 0, 0.5, 0)
    BillboardGui.StudsOffset = Vector3.new(0, 3, 0)
    BillboardGui.AlwaysOnTop = true -- ทำให้เห็นทะลุ
    BillboardGui.ResetOnSpawn = false

    local Frame = Instance.new("Frame")
    Frame.BackgroundColor3 = Color3.fromRGB(0,255,0)
    Frame.BorderSizePixel = 0
    Frame.Size = UDim2.new(1, 0, 1, 0)
    Frame.Parent = BillboardGui

    BillboardGui.Parent = game.CoreGui

    ESPs[player] = {HL = hl, GUI = BillboardGui, Frame = Frame}

    -- อัปเดต Highlight + Health Bar
    local function Update()
        local char = player.Character
        local humanoid = char and char:FindFirstChild("Humanoid")
        local head = char and char:FindFirstChild("Head")
        
        -- อัปเดต Highlight
        if ESPEnabled and char and char:FindFirstChild("HumanoidRootPart") then
            hl.Adornee = char
            hl.Enabled = true
            if player.Team then
                local c = player.Team.TeamColor.Color
                hl.FillColor = c
                hl.OutlineColor = c
            else
                hl.FillColor = Color3.new(1,1,1)
                hl.OutlineColor = Color3.new(1,1,1)
            end
        else
            hl.Enabled = false
        end

        -- อัปเดต Health Bar
        if ESPEnabled and humanoid and head then
            BillboardGui.Adornee = head
            BillboardGui.Enabled = true

            local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            Frame.Size = UDim2.new(ratio, 0, 1, 0)

            if ratio > 0.5 then
                Frame.BackgroundColor3 = Color3.fromRGB(0,255,0)
            elseif ratio > 0.2 then
                Frame.BackgroundColor3 = Color3.fromRGB(255,165,0)
            else
                Frame.BackgroundColor3 = Color3.fromRGB(255,0,0)
            end
        else
            BillboardGui.Enabled = false
        end
    end

    -- เชื่อมต่ออัปเดตอัตโนมัติ
    player.CharacterAdded:Connect(Update)
    player:GetPropertyChangedSignal("Team"):Connect(Update)
    game:GetService("RunService").Heartbeat:Connect(Update)
end

-- ฟังก์ชันลบ ESP เมื่อผู้เล่นออก
local function RemoveESP(player)
    if ESPs[player] then
        if ESPs[player].HL then ESPs[player].HL:Destroy() end
        if ESPs[player].GUI then ESPs[player].GUI:Destroy() end
        ESPs[player] = nil
    end
end

