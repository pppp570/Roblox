local __old
__old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if SilentAim
        and TeamSelected
        and CurrentTarget
        and method == "Raycast"
        and typeof(args[1]) == "Vector3"
        and typeof(args[2]) == "Vector3" then

        local origin = args[1]
        local dir = (CurrentTarget.Position - origin)
        return __old(self, origin, dir, args[3])
    end

    return __old(self, ...)
end)

