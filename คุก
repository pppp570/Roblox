--------------------------------------------------
-- FOV POLYGON
--------------------------------------------------
local FOV = {
    Radius = FOV_RADIUS,
    Sides = 8,
    Color = FOV_COLOR,
    Lines = {}
}

function FOV:Init()
    for i = 1, self.Sides do
        local l = Drawing.new("Line")
        l.Thickness = 2
        l.Visible = false
        table.insert(self.Lines, l)
    end
end

function FOV:GetPoints(center)
    local pts = {}
    for i = 1, self.Sides do
        local a = (2 * math.pi / self.Sides) * i
        pts[i] = Vector2.new(
            center.X + math.cos(a) * self.Radius,
            center.Y + math.sin(a) * self.Radius
        )
    end
    return pts
end

function FOV:SetVisible(v)
    for _,l in ipairs(self.Lines) do
        l.Visible = v
    end
end

function FOV:Update(center)
    if not ShowVisual or not SilentAim then
        self:SetVisible(false)
        return
    end

    local pts = self:GetPoints(center)
    for i = 1, self.Sides do
        local l = self.Lines[i]
        l.From = pts[i]
        l.To = pts[(i % self.Sides) + 1]
        l.Color = self.Color
        l.Visible = true -- << วงขึ้นเสมอ
    end
end

FOV:Init()

