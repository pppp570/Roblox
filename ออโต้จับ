-- SERVICES
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local ArrestRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ArrestPlayer")

-- SETTINGS
local AutoArrestEnabled = false -- << เริ่มต้นปิด
local ArrestRange = 20 -- ระยะจับ (studs)

-- LOOP CONNECTION VARIABLE
local connection

-- FUNCTION: Arrest nearby players
local function AutoArrest()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if distance <= ArrestRange then
                pcall(function()
                    ArrestRemote:InvokeServer(player)
                end)
            end
        end
    end
end

-- START LOOP (แต่ไม่ทำอะไรถ้า AutoArrestEnabled = false)
connection = RunService.RenderStepped:Connect(function()
    if AutoArrestEnabled then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            AutoArrest()
        end
    end
end)

-- FUNCTION: เปิด AutoArrest
local function StartAutoArrest()
    AutoArrestEnabled = true
end

-- FUNCTION: ปิด AutoArrest
local function StopAutoArrest()
    AutoArrestEnabled = false
end

-- FUNCTION: หยุดถาวร
local function StopAutoArrestPermanently()
    AutoArrestEnabled = false
    if connection then
        connection:Disconnect()
        connection = nil
    end
    AutoArrest = function() end
    ArrestRemote = nil
end

-- ตัวอย่างใช้งาน:
-- เริ่มจับเอง: StartAutoArrest()
-- หยุดชั่วคราว: StopAutoArrest()
-- หยุดถาวร: StopAutoArrestPermanently()
