-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")

local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local ScriptEnabled = true -- สคริปต์เปิดอัตโนมัติ
local OffsetY = -1 -- ปรับให้ GUI อยู่ใต้เท้าลงไป

-- ฟังก์ชันตรวจสอบไอเทมของผู้เล่น
local function getPlayerTools(player)
    local tools = {}

    if player.Character then
        for _, tool in ipairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(tools, tool.Name)
            end
        end
    end

    if player:FindFirstChild("Backpack") then
        for _, tool in ipairs(player.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(tools, tool.Name)
            end
        end
    end

    return tools
end

-- สร้าง GUI ใต้เท้าแสดงไอเทมเรียงลงล่างในวงเล็บ
local function createItemGUI(player)
    if not player.Character then return end
    if player.Team == LocalPlayer.Team then return end -- ไม่แสดงทีมตัวเอง

    local tools = getPlayerTools(player)
    if #tools == 0 then
        local old = player.Character:FindFirstChild("ItemTag")
        if old then old:Destroy() end
        return
    end

    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local billboard = player.Character:FindFirstChild("ItemTag")
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ItemTag"
        billboard.Adornee = rootPart
        billboard.Size = UDim2.new(0, 120, 0, (#tools * 14))
        billboard.StudsOffset = Vector3.new(0, OffsetY, 0) -- อยู่ใต้เท้า
        billboard.AlwaysOnTop = true
        billboard.Parent = player.Character
    end

    -- ลบ children เดิม
    for _, child in ipairs(billboard:GetChildren()) do
        child:Destroy()
    end

    -- สร้าง TextLabel แต่ละไอเทมเรียงลงด้านล่างในวงเล็บ
    for i, toolName in ipairs(tools) do
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1,0,0,14)
        label.Position = UDim2.new(0,0,(i-1)/#tools,0)
        label.BackgroundTransparency = 1
        label.TextScaled = false
        label.Font = Enum.Font.SourceSans
        label.TextColor3 = Color3.fromRGB(255,255,255)
        label.TextStrokeTransparency = 0
        label.Text = "["..toolName.."]"
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.Parent = billboard
    end

    billboard.Enabled = ScriptEnabled
end

-- สร้าง GUI ให้ผู้เล่น
local function setupPlayer(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        createItemGUI(player)
    end)
    if player.Character then
        task.wait(0.5)
        createItemGUI(player)
    end
end

-- เริ่มต้นกับผู้เล่นที่อยู่แล้ว
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        setupPlayer(player)
    end
end

-- ผู้เล่นใหม่เข้ามา
Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        setupPlayer(player)
    end
end)

-- อัพเดต GUI ใต้เท้าผู้เล่นทุกเฟรม
RunService.RenderStepped:Connect(function()
    if not ScriptEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createItemGUI(player)
        end
    end
end)
