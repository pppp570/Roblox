	btn.TextColor3 = Color3.fromRGB(255,90,90)
	soundOff:Play()
	TweenService:Create(btn, TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(40,40,40) }):Play()
	TweenService:Create(stroke, TweenInfo.new(0.25), { Color = Color3.fromRGB(255,90,90) }):Play()
end

--------------------------------------------------
-- PLAYER UPDATE
--------------------------------------------------
Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(1)
		if enabled then
			refreshOthers()
		end
	end)
end)

Players.PlayerRemoving:Connect(function()
	refreshOthers()
end)

--------------------------------------------------
-- TOGGLE BUTTON
--------------------------------------------------
btn.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		setON()
		refreshOthers()
		startMeleeLoop() -- เปิด meleeEvent

		connection = RunService.Heartbeat:Connect(function(dt)
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			angle += dt * 9
			local radius = 4

			for i,plr in ipairs(others) do
				local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local a = angle + (i / #others) * math.pi * 2
					hrp.CFrame = root.CFrame * CFrame.new(
						math.cos(a) * radius,
						0,
						math.sin(a) * radius
					)
					setTransparency(plr, 0)
				end
			end

			for _,plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and not table.find(others, plr) then
					setTransparency(plr, 1)
				end
			end
		end)
	else
		setOFF()
		if connection then
			connection:Disconnect()
			connection = nil
		end
		stopMeleeLoop() -- ปิด meleeEvent
		resetAll()
	end
end)
