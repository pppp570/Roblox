--------------------------------------------------
-- SERVICES
--------------------------------------------------
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local REMOTE = ReplicatedStorage:WaitForChild("meleeEvent")

--------------------------------------------------
-- VARIABLES
--------------------------------------------------
local enabled = false
local connection
local angle = 0
local others = {}

local RANGE = 10 -- ระยะตรวจสอบผู้เล่นใกล้
local meleeEnabled = false
local meleeConnection

--------------------------------------------------
-- FUNCTIONS
--------------------------------------------------
-- GUI Functions
local function setTransparency(plr, value)
	if plr.Character then
		for _,v in ipairs(plr.Character:GetDescendants()) do
			if v:IsA("BasePart") then
				v.LocalTransparencyModifier = value
			end
		end
	end
end

local function resetAll()
	for _,plr in ipairs(Players:GetPlayers()) do
		setTransparency(plr, 0)
	end
end

local function refreshOthers()
	others = {}
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer
		and plr.Character
		and plr.Character:FindFirstChild("HumanoidRootPart") then
			table.insert(others, plr)
		end
	end
end

-- Melee Functions
local function GetNearbyPlayers()
    local nearby = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (player.Character.HumanoidRootPart.Position - RootPart.Position).Magnitude
            if distance <= RANGE then
                table.insert(nearby, player)
            end
        end
    end
    return nearby
end

local function startMeleeLoop()
    if meleeConnection then return end
    meleeEnabled = true
    meleeConnection = RunService.Heartbeat:Connect(function()
        if not meleeEnabled then return end
        local targets = GetNearbyPlayers()
        for _, target in pairs(targets) do
            local success, err = pcall(function()
                REMOTE:FireServer(target)
            end)
            if not success then
                warn("Error firing meleeEvent:", err)
            end
        end
    end)
end

local function stopMeleeLoop()
    meleeEnabled = false
    if meleeConnection then
        meleeConnection:Disconnect()
        meleeConnection = nil
    end
end

