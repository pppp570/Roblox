-- ================= SETTINGS =================
local SilentAimEnabled = false
local FOVRadius = 120
local CurrentTarget = nil

-- ================= DRAW =================
local Circle = Drawing.new("Circle")
Circle.Color = Color3.fromRGB(255, 0, 0)
Circle.Thickness = 1.5
Circle.NumSides = 64
