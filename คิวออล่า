--==================================================
-- SERVICES
--==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- RemoteEvent
local REMOTE = ReplicatedStorage:WaitForChild("meleeEvent")
local RANGE = 10
local Enabled = false -- เริ่มปิด ต้องเปิดเอง

--==================================================
-- ตัวละครและ RootPart
--==================================================
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:FindFirstChild("HumanoidRootPart")

-- อัปเดต RootPart ถ้า Character เปลี่ยน
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
end)

--==================================================
-- ฟังก์ชันตรวจสอบผู้เล่นใกล้
--==================================================
local function GetNearbyPlayers()
    local nearby = {}
    if not RootPart then return nearby end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local distance = (targetRoot.Position - RootPart.Position).Magnitude
                if distance <= RANGE then
                    table.insert(nearby, targetRoot) -- เก็บ RootPart ของผู้เล่นแทน Player
                end
            end
        end
    end
    return nearby
end

--==================================================
-- ฟังก์ชันเปิด/ปิด
--==================================================
local function ToggleMelee()
    Enabled = not Enabled
    print("Melee:", Enabled and "ON" or "OFF")
end

--==================================================
-- Loop หลัก
--==================================================
RunService.Heartbeat:Connect(function()
    if not Enabled then return end
    if not RootPart then return end

    local targets = GetNearbyPlayers()
    for _, targetRoot in pairs(targets) do
        local success, err = pcall(function()
            -- FireServer ไปที่ RootPart ของผู้เล่นใกล้
            REMOTE:FireServer(targetRoot)
        end)
        if not success then
            warn("Error firing meleeEvent:", err)
        end
    end
end)

