--==================================================
-- SERVICES
--==================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- RemoteEvent
local REMOTE = ReplicatedStorage:WaitForChild("meleeEvent")
local RANGE = 10 -- ระยะตรวจสอบผู้เล่นใกล้
local Enabled = false -- เริ่มต้นปิด ต้องเปิดเอง

--==================================================
-- ตัวละครและ RootPart
--==================================================
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:FindFirstChild("HumanoidRootPart")

-- อัปเดต RootPart ถ้า Character เปลี่ยน
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
end)

--==================================================
-- ฟังก์ชันตรวจสอบผู้เล่นใกล้
--==================================================
local function GetNearbyPlayers()
    local nearby = {}
    if not RootPart then return nearby end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (player.Character.HumanoidRootPart.Position - RootPart.Position).Magnitude
            if distance <= RANGE then
                table.insert(nearby, player)
            end
        end
    end
    return nearby
end

--==================================================
-- ฟังก์ชันเปิด/ปิด
--==================================================
local function ToggleMelee()
    Enabled = not Enabled
    print("Melee:", Enabled and "ON" or "OFF")
end

--==================================================
-- Loop หลัก
--==================================================
RunService.Heartbeat:Connect(function()
    -- ตรวจสอบ Enabled ก่อนเลย
    if not Enabled then return end

    -- ตรวจสอบ RootPart พร้อม
    if not RootPart or not RootPart.Parent then return end

    local targets = GetNearbyPlayers()
    for _, target in pairs(targets) do
        local success, err = pcall(function()
            REMOTE:FireServer(target)
        end)
        if not success then
            warn("Error firing meleeEvent:", err)
        end
    end
end)

