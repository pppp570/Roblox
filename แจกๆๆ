-- ==========================
-- FUNCTIONS
-- ==========================
local function GetNearestCharacter()
    local nearest = nil
    local shortest = math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local headPos = plr.Character.Head.Position
            local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if dist < FOVRadius and dist < shortest then
                    shortest = dist
                    nearest = plr.Character.Head
                end
            end
        end
    end
    return nearest
end

-- ==========================
-- ESP Drawing
-- ==========================
local function CreateESP(player)
    local bar = Drawing.new("Square")
    bar.Size = Vector2.new(BAR_WIDTH, BAR_HEIGHT)
    bar.Color = Color3.fromRGB(0,255,0)
    bar.Thickness = 1
    bar.Filled = true
    bar.Visible = ESPEnabled
    return bar
end

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        ESPBars[player] = CreateESP(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        ESPBars[player] = CreateESP(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if ESPBars[player] then
        ESPBars[player]:Remove()
        ESPBars[player] = nil
    end
end)

-- ==========================
-- HITBOX FUNCTIONS
-- ==========================
local OriginalProps = {}
local function setHitbox(plr)
    if plr == LocalPlayer then return end
    if not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        if not OriginalProps[plr] then
            OriginalProps[plr] = {
                Size = hrp.Size,
                Shape = hrp.Shape,
                Transparency = hrp.Transparency,
                BrickColor = hrp.BrickColor,
                Material = hrp.Material,
                CanCollide = hrp.CanCollide
            }
        end
        hrp.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
        hrp.Shape = Enum.PartType.Ball
        hrp.Transparency = 0.7
        hrp.BrickColor = BrickColor.new("Really black")
        hrp.Material = Enum.Material.Neon
        hrp.CanCollide = false
    end)
end

