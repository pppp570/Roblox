-- ==========================
-- MAIN LOOP
-- ==========================
RunService.RenderStepped:Connect(function()
    FOV.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    if StopAll then
        Line.Visible = false
        FOV.Visible = false
        Box.Visible = false
        return
    end

    -- AimBot
    if AimEnabled then
        local target = GetNearestCharacter()
        if target then
            local screenPos, vis = Camera:WorldToViewportPoint(target.Position)
            if vis then
                Line.From = FOV.Position
                Line.To = Vector2.new(screenPos.X, screenPos.Y)
                Line.Visible = true

                Box.Position = Vector2.new(screenPos.X - Box.Size.X/2, screenPos.Y - Box.Size.Y/2)
                Box.Visible = true

                local camCFrame = Camera.CFrame
                local lookVector = (target.Position - camCFrame.Position).Unit
                Camera.CFrame = CFrame.new(camCFrame.Position, camCFrame.Position + lookVector:Lerp(camCFrame.LookVector, Smoothness))
            else
                Line.Visible = false
                Box.Visible = false
            end
        else
            Line.Visible = false
            Box.Visible = false
        end
    else
        Line.Visible = false
        Box.Visible = false
    end

    -- Hitbox
    if HitboxEnabled then
        for _, plr in pairs(Players:GetPlayers()) do setHitbox(plr) end
    end

    -- Noclip (อัปเดตตลอดเวลา)
    if LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not NoclipEnabled and true or false
            end
        end
    end

    -- Update ESP Bars
    for player, bar in pairs(ESPBars) do
        if ESPEnabled then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0,3,0))
                bar.Visible = onScreen
                if onScreen then
                    local healthRatio = math.clamp(humanoid.Health / humanoid.MaxHealth,0,1)
                    bar.Size = Vector2.new(BAR_WIDTH, BAR_HEIGHT * healthRatio)
                    bar.Position = Vector2.new(screenPos.X + BAR_OFFSET_X, screenPos.Y - BAR_HEIGHT * healthRatio)
                    bar.Color = Color3.new(1 - healthRatio, healthRatio, 0)
                end
            else
                bar.Visible = false
            end
        else
            bar.Visible = false
        end
    end
end)
