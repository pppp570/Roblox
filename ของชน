        Max = 100,
        Default = _G.HeadSize,
    },
    Callback = function(value)
        _G.HeadSize = value
        if _G.ESPEnabled then
            ApplyHitbox()
        end
    end
})

HitboxTab:Colorpicker({
    Title = "Color",
    Default = _G.VisualColor,
    Transparency = 0,
    Callback = function(color)
        _G.VisualColor = color
        if _G.ESPEnabled then
            ApplyHitbox()
        end
    end
})
local ESPTab = Window:Tab({
    Title = "ESP",
    Icon = "eye",
    Locked = false,
})

local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local ENABLE = false
local LINE_THICKNESS = 1.8
local RGB_SPEED = 0.6

local Lines = {}

local function createLine(player)
    if player == LocalPlayer then return end
    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = LINE_THICKNESS
    line.Transparency = 1
    Lines[player] = line
end

local function removeLine(player)
    if Lines[player] then
        Lines[player]:Remove()
        Lines[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    createLine(p)
end

Players.PlayerAdded:Connect(createLine)
Players.PlayerRemoving:Connect(removeLine)

RunService.RenderStepped:Connect(function()
    if not ENABLE then
        for _, line in pairs(Lines) do
            line.Visible = false
        end
        return
    end

    local screenSize = Camera.ViewportSize
    local topCenter = Vector2.new(screenSize.X / 2, 0)

    local hue = (tick() * RGB_SPEED) % 1
    local rgbColor = Color3.fromHSV(hue, 1, 1)

    for player, line in pairs(Lines) do
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if head and hum and hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                line.From = Vector2.new(pos.X, pos.Y)
                line.To = topCenter
                line.Color = rgbColor
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end)

ESPTab:Toggle({
    Title = "ESP Line",
    Default = false,
    Callback = function(state)
        ENABLE = state
        if not state then
            for _, line in pairs(Lines) do
                line.Visible = false
            end
        end
    end
})
