local function executeScript(url)
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success then
        local script = loadstring(result)
        if script then
            script()
        else
            warn("Failed to load script.")
        end
    else
        warn("Error downloading script: " .. result)
    end
end

