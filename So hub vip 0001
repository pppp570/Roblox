})
-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local ENABLE = false -- ❗ ให้ Toggle คุม
local LINE_THICKNESS = 1.8
local RGB_SPEED = 0.6

local Lines = {}

-- ================== CREATE / REMOVE LINE ==================
local function createLine(player)
if player == LocalPlayer then return end

local line = Drawing.new("Line")  
line.Visible = false  
line.Thickness = LINE_THICKNESS  
line.Transparency = 1  

Lines[player] = line

end

local function removeLine(player)
if Lines[player] then
Lines[player]:Remove()
Lines[player] = nil
end
end

-- ================== PLAYER CHECK ==================
for _, p in ipairs(Players:GetPlayers()) do
createLine(p)
end

Players.PlayerAdded:Connect(createLine)
Players.PlayerRemoving:Connect(removeLine)

-- ================== RENDER ==================
RunService.RenderStepped:Connect(function()
if not ENABLE then
for _, line in pairs(Lines) do
line.Visible = false
end
return
end

local screenSize = Camera.ViewportSize  
local topCenter = Vector2.new(screenSize.X / 2, 0)  

local hue = (tick() * RGB_SPEED) % 1  
local rgbColor = Color3.fromHSV(hue, 1, 1)  

for player, line in pairs(Lines) do  
	local char = player.Character  
	local head = char and char:FindFirstChild("Head")  
	local hum = char and char:FindFirstChildOfClass("Humanoid")  

	if head and hum and hum.Health > 0 then  
		local pos, onScreen = Camera:WorldToViewportPoint(head.Position)  

		if onScreen then  
			line.From = Vector2.new(pos.X, pos.Y)  
			line.To = topCenter  
			line.Color = rgbColor  
			line.Visible = true  
		else  
			line.Visible = false  
		end  
	else  
		line.Visible = false  
	end  
end

end)

-- ================== TOGGLE ==================
local Toggle = Tab:Toggle({
Title = "ESP Line",
Icon = "eye",
Type = "Checkbox",
Value = false,
Callback = function(state)
ENABLE = state

if not state then  
        -- ปิดแล้วซ่อนเส้นทั้งหมดทันที  
        for _, line in pairs(Lines) do  
            line.Visible = false  
        end  
    end  
end

})
