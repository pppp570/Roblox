-- ฟังก์ชันตรวจสอบว่าเป้าหมายใช้งานได้

local function isValidTarget(player, partName)
if player == LocalPlayer then return false end
if not player.Character then return false end

local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
local part = player.Character:FindFirstChild(partName)

if not humanoid or humanoid.Health <= 0 then
return false
end

if not part then
return false
end

local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)

if not onScreen or screenPos.Z <= 0 then
return false
end

return true

end


---

-- หาเป้าหมายใกล้กลางจอที่สุด

local function getClosestTarget(partName)
local closest = nil
local shortestDistance = math.huge
local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

for _, player in pairs(Players:GetPlayers()) do
if isValidTarget(player, partName) then
local part = player.Character[partName]
local screenPos = Camera:WorldToViewportPoint(part.Position)
local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude

if distance < shortestDistance then    
        shortestDistance = distance    
        closest = part    
    end    
end

end

return closest

end


