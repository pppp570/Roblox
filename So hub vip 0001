-- TOGGLE เปิด/ปิดล็อค

local Toggle = Tab:Toggle({
Title = "ยืนยันเปิดการล็อค",
Desc = "ต้องเลือกโหมดก่อนถึงจะเปิดได้",
Default = false,
Callback = function(state)

-- ถ้าไม่เลือกอะไรเลย → ไม่ให้เปิด
if state and (#selectedModes == 0) then
warn("กรุณาเลือกโหมดก่อน")
Toggle:Set(false)
return
end

-- ปิดระบบ    
if not state then    
    if lockConnection then    
        lockConnection:Disconnect()    
        lockConnection = nil    
    end    
    currentTarget = nil    
    return    
end    

-- เปิดระบบ    
lockConnection = RunService.RenderStepped:Connect(function()    

    local partName = nil    

    -- ถ้าเลือกหัว ให้หัวมาก่อน    
    if table.find(selectedModes, "ล็อคหัว") then    
        partName = "Head"    
    elseif table.find(selectedModes, "ล็อคตัว") then    
        partName = "HumanoidRootPart"    
    end    

    if not partName then return end    

    -- ถ้าเป้าหมายเดิมยังใช้ได้ ให้ใช้ต่อ    
    if currentTarget and currentTarget.Parent then    
        local humanoid = currentTarget.Parent:FindFirstChildOfClass("Humanoid")    
        local screenPos, onScreen = Camera:WorldToViewportPoint(currentTarget.Position)    

        if humanoid and humanoid.Health > 0 and onScreen and screenPos.Z > 0 then    
            local newCFrame = CFrame.new(    
                Camera.CFrame.Position,    
                currentTarget.Position    
            )    
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.25)    
            return    
        end    
    end    

    -- หาเป้าหมายใหม่    
    currentTarget = getClosestTarget(partName)    

    if currentTarget then    
        local newCFrame = CFrame.new(    
            Camera.CFrame.Position,    
            currentTarget.Position    
        )    
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.25)    
    end    
end)

end

