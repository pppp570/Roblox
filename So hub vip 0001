--------------------------------------------------
-- TOGGLE LOCK
--------------------------------------------------

local Toggle = Tab:Toggle({
    Title = "เปิด Aimbot",
    Desc = "ต้องเลือกโหมดก่อน",
    Default = false,
    Callback = function(state)

        if state and (#selectedModes == 0) then
            warn("กรุณาเลือกโหมดก่อน")
            Toggle:Set(false)
            return
        end

        if not state then
            if lockConnection then
                lockConnection:Disconnect()
                lockConnection = nil
            end
            currentTarget = nil
            return
        end

        lockConnection = RunService.RenderStepped:Connect(function()

            local partName = nil

            if table.find(selectedModes,"ล็อคหัว") then
                partName = "Head"
            elseif table.find(selectedModes,"ล็อคตัว") then
                partName = "HumanoidRootPart"
            end

            if not partName then return end

            currentTarget = getClosestTarget(partName)

            if currentTarget then
                local newCFrame = CFrame.new(
                    Camera.CFrame.Position,
                    currentTarget.Position
                )
                Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.2)
            end

        end)
    end
})

