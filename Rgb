-- SERVICES
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Backpack = LocalPlayer:WaitForChild("Backpack")

-- VARIABLES
local highlightEnabled = true -- เปิดใช้งานโดยอัตโนมัติ
local highlight = nil
local currentTool = nil

-- สีเรนโบว์สดใส
local rainbowColors = {
	Color3.fromRGB(255,0,0),      -- แดง
	Color3.fromRGB(255,127,0),    -- ส้ม
	Color3.fromRGB(255,255,0),    -- เหลือง
	Color3.fromRGB(0,255,0),      -- เขียว
	Color3.fromRGB(0,0,255),      -- น้ำเงิน
	Color3.fromRGB(75,0,130),     -- คราม
	Color3.fromRGB(148,0,211),    -- ม่วง
}

local colorIndex = 1
local tweenTime = 0.2 -- เปลี่ยนสีเร็ว

-- FUNCTIONS
local function createHighlight(tool)
	if highlight then
		highlight:Destroy()
	end
	highlight = Instance.new("Highlight")
	highlight.Adornee = tool
	highlight.FillTransparency = 0.2
	highlight.OutlineTransparency = 0
	highlight.Parent = tool
end

local function removeHighlight()
	if highlight then
		highlight:Destroy()
		highlight = nil
	end
end

local function tweenColor()
	if highlight then
		local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
		local goal = {FillColor = rainbowColors[colorIndex]}
		local tween = TweenService:Create(highlight, tweenInfo, goal)
		tween:Play()
		tween.Completed:Connect(function()
			colorIndex = colorIndex + 1
			if colorIndex > #rainbowColors then
				colorIndex = 1
			end
			if highlightEnabled then
				tweenColor()
			end
		end)
	end
end

-- เริ่ม Highlight สำหรับ Tool ที่ถืออยู่
currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool") or Backpack:FindFirstChildOfClass("Tool")
if currentTool then
	createHighlight(currentTool)
	tweenColor()
end

-- Detect tool change
LocalPlayer.Character.ChildAdded:Connect(function(child)
	if child:IsA("Tool") and highlightEnabled then
		currentTool = child
		createHighlight(currentTool)
		tweenColor()
	end
end)
