-- ฟังก์ชันบังคับไม่ให้นั่ง
local function forceStand(char)
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
            if humanoid.Sit then
                humanoid.Sit = false
            end
        end)

        task.spawn(function()
            while char.Parent do
                if humanoid.Sit then
                    humanoid.Sit = false
                end
                task.wait(0.1)
            end
        end)
    end
end

