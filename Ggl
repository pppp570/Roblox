function DrawPathLine(startPos, endPos)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(180, 0, 255)
	part.Transparency = 0.25
	local distance = (startPos - endPos).Magnitude
	part.Size = Vector3.new(0.2, 0.2, distance)
	part.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
	part.Parent = PathPartsFolder
end

function ClearPathLines()
	for _, v in pairs(PathPartsFolder:GetChildren()) do
		v:Destroy()
	end
end
local Tween

function TPX(p)
    if Tween then
        Tween:Cancel()
        Tween = nil
    end

    local player = game.Players.LocalPlayer
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local Distance = (p.Position - root.Position).Magnitude
    local Speed = 130

    Tween = game:GetService("TweenService"):Create(
        root,
        TweenInfo.new(Distance / Speed, Enum.EasingStyle.Linear),
        {CFrame = p}
    )

    root.CFrame = CFrame.new(root.Position.X, 10, root.Position.Z)

    Tween:Play()

    task.spawn(function()
        while Tween and Tween.PlaybackState == Enum.PlaybackState.Playing do
            if not _G.FarmCement then
                Tween:Cancel()
                Tween = nil
				root.CFrame = CFrame.new(root.Position.X, 20, root.Position.Z)
                break
            end
            task.wait()
        end
    end)
end

function TP(targetCFrame)
	if LocalPlayer.Character.Humanoid.Sit then
		LocalPlayer.Character.Humanoid.Sit = false
		wait(1)
		return
	end
	ClearPathLines()
	local targetPos = targetCFrame.Position
	local path = PathfindingService:CreatePath({
		AgentRadius = 5,
		AgentHeight = 5,
		AgentCanJump = true,
		WaypointSpacing = 5,
	})

	path:ComputeAsync(LocalPlayer.Character:WaitForChild("HumanoidRootPart").Position, targetPos)

	if path.Status == Enum.PathStatus.Success then
		local waypoints = path:GetWaypoints()
		for i = 1, #waypoints - 1 do
			DrawPathLine(waypoints[i].Position, waypoints[i + 1].Position)
		end
		for _, waypoint in ipairs(waypoints) do
			if _G.FarmCement == false then
				if Tween then Tween:Cancel() end
				ClearPathLines()
				return
			end

			local distance = (LocalPlayer.Character.HumanoidRootPart.Position - waypoint.Position).Magnitude
			local speed = 130
			local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

			if Tween then
				Tween:Cancel()
			end

			Tween = TweenService:Create(LocalPlayer.Character.HumanoidRootPart, tweenInfo, {CFrame = CFrame.new(waypoint.Position)})
			Tween:Play()
			Tween.Completed:Wait()

			if waypoint.Action == Enum.PathWaypointAction.Jump then
				LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
		ClearPathLines()
	else
		local distance = (LocalPlayer.Character.HumanoidRootPart.Position - targetPos).Magnitude
		local speed = 130
		local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)

		if Tween then
			Tween:Cancel()
		end

		Tween = TweenService:Create(LocalPlayer.Character.HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
		Tween:Play()
		while Tween.PlaybackState ~= Enum.PlaybackState.Completed do
			if _G.FarmCement == false then
				Tween:Cancel()
				return
			end
			task.wait(0.1)
		end
	end
end

