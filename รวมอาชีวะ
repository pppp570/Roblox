    workspace:FindFirstChild("\224\184\151\224\184\181\224\185\136\224\184\159\224\184\178\224\184\163\224\185\140\224\184\161\224\184\156\224\184\177\224\184\129") and
    workspace["\224\184\151\224\184\181\224\185\136\224\184\159\224\184\178\224\184\163\224\185\140\224\184\161\224\184\156\224\184\177\224\184\129"]:FindFirstChild("\224\184\159\224\184\178\224\184\163\224\185\140\224\184\161") or nil
}

-- ฟังก์ชัน AutoFarm
local function StartAutoFarm()
    _G.AutoFarm = true
    spawn(function()
        while _G.AutoFarm do
            for _, target in pairs(promptTargets) do
                if target and target:IsA("Instance") then
                    for _, obj in pairs(target:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            -- ป้องกัน error
                            pcall(function()
                                fireproximityprompt(obj, 0)
                            end)
                        end
                    end
                end
            end
            task.wait(taskDelay)
        end
    end)
end

local function StopAutoFarm()
    _G.AutoFarm = false
end

-- Toggle เปิด/ปิด AutoFarm
Tabs.Features:Toggle({
    Title = "Enable AutoFarm",
    Value = false,
    Callback = function(state)
        if state then
            StartAutoFarm()
        else
            StopAutoFarm()
        end
    end
})

-- Slider ปรับ Delay
Tabs.Features:Slider({
