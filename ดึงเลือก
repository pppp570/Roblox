refresh.MouseButton1Click:Connect(rebuildList)
Players.PlayerAdded:Connect(function() task.wait(1); rebuildList() end)
Players.PlayerRemoving:Connect(rebuildList)

--------------------------------------------------
-- TOGGLE SPIN
--------------------------------------------------
toggle.MouseButton1Click:Connect(function()
	enabled = not enabled
	toggle.Text = enabled and "ON" or "OFF"

	if enabled then
		connection = RunService.Heartbeat:Connect(function(dt)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root then return end

			angle += dt * spinSpeed
			local radius = 5
			local index = 0

			for _,plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and (modeAll or selected[plr]) then
					local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
					if hrp then
						index += 1
						local a = angle + index * math.pi * 2 / 8
						hrp.CFrame = root.CFrame * CFrame.new(
							math.cos(a)*radius,
							0,
							math.sin(a)*radius
						)
					end
				end
			end
		end)
	else
		if connection then connection:Disconnect() end
	end
end)

