-- SERVICES
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local ArrestRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ArrestPlayer")

-- SETTINGS
local AutoArrestEnabled = true -- เปลี่ยนเป็น false เพื่อหยุดสคริปต์
local ArrestRange = 20 -- ระยะจับ (studs)

-- LOOP CONNECTION VARIABLE
local connection

-- FUNCTION: Arrest nearby players
local function AutoArrest()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if distance <= ArrestRange then
                pcall(function()
                    ArrestRemote:InvokeServer(player)
                end)
            end
        end
    end
end

-- START LOOP
connection = RunService.RenderStepped:Connect(function()
    if AutoArrestEnabled then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            AutoArrest()
        end
    end
end)

-- FUNCTION: Stop Auto Arrest และคืนค่าเดิม
local function RestoreDefault()
    -- ปิด Auto Arrest
    AutoArrestEnabled = false

    -- ตัดการเชื่อมต่อ Loop
    if connection then
        connection:Disconnect()
        connection = nil
    end

    -- คืนค่าอื่น ๆ (ถ้ามีค่า default เพิ่มเติม)
    ArrestRange = 20
end

-- ตัวอย่างเรียกคืนค่าเดิม
