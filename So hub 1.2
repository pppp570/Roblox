-- ส่วน ESP + Tracer

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local colors = {
    Color3.fromRGB(255, 0, 0),
    Color3.fromRGB(255, 127, 0),
    Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(0, 255, 0),
    Color3.fromRGB(0, 0, 255),
    Color3.fromRGB(75, 0, 130),
    Color3.fromRGB(148, 0, 211)
}

local PlayerData = {}

local function addPlayer(plr)
    if plr == LocalPlayer then return end
    if PlayerData[plr] then return end

    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "Highlight"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.FillColor = colors[1]
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = plr

    local function updateAdornee()
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            highlight.Adornee = plr.Character.HumanoidRootPart
        end
    end

    if plr.Character then updateAdornee() end
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        updateAdornee()
    end)

    -- Tracer
    local tracer = Drawing.new("Line")
    tracer.Visible = true
    tracer.Color = Color3.fromRGB(255,0,0)
    tracer.Thickness = 1.5
    tracer.Transparency = 1

    PlayerData[plr] = {Highlight = highlight, Tracer = tracer}
end

local function removePlayer(plr)
    if PlayerData[plr] then
        if PlayerData[plr].Highlight then PlayerData[plr].Highlight:Destroy() end
        if PlayerData[plr].Tracer then PlayerData[plr].Tracer:Remove() end
        PlayerData[plr] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do
    addPlayer(plr)
end

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)

-- ลูปอัปเดตเส้นทุกเฟรม
RunService.RenderStepped:Connect(function()
    local localChar = LocalPlayer.Character
    local startPos

    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
        startPos = localChar.HumanoidRootPart.Position - Vector3.new(0, localChar.HumanoidRootPart.Size.Y/2, 0)
    else
        return
    end

    local colorIndex = tick() * 2 % #colors + 1

    for plr, data in pairs(PlayerData) do
        -- ถ้า ESP ปิด ให้ซ่อน Highlight + Tracer
        if not ESPEnabled then
            data.Tracer.Visible = false
            if data.Highlight then data.Highlight.FillColor = Color3.fromRGB(255,255,255) end
        else
            -- สลับสี Highlight
            if data.Highlight then
                local cIndex = math.floor(colorIndex) % #colors + 1
                data.Highlight.FillColor = colors[cIndex]
            end

            -- Tracer
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local targetPos = plr.Character.HumanoidRootPart.Position
                local screenStart, onScreenStart = Camera:WorldToViewportPoint(startPos)
                local screenEnd, onScreenEnd = Camera:WorldToViewportPoint(targetPos)

                if onScreenStart and onScreenEnd then
                    data.Tracer.From = Vector2.new(screenStart.X, screenStart.Y)
                    data.Tracer.To = Vector2.new(screenEnd.X, screenEnd.Y)
                    data.Tracer.Visible = true
                    data.Tracer.Color = colors[math.floor(colorIndex) % #colors +1]
                else
                    data.Tracer.Visible = false
                end
            else
                data.Tracer.Visible = false
            end
        end
    end
end)

