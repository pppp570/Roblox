local Players = game:GetService("Players")
local Speed = 0.1

-- ลบ highlight ทั้งหมดจากทุกคน
local function RemoveAllHighlights()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            local h = plr.Character:FindFirstChild("Highlight_Rainbow")
            if h then h:Destroy() end
        end
    end
end

-- สร้าง highlight ใหม่
local function CreateHighlight(char)
    if char:FindFirstChild("Highlight_Rainbow") then
        return char.Highlight_Rainbow
    end

    local h = Instance.new("Highlight")
    h.Name = "Highlight_Rainbow"
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Parent = char
    return h
end

-- เมื่อผู้เล่นเกิด
local function SetupPlayer(plr)
    plr.CharacterAdded:Connect(function(char)
        task.wait(1)
        if HighlightEnabled then
            CreateHighlight(char)
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    SetupPlayer(plr)
end

Players.PlayerAdded:Connect(SetupPlayer)

-- LOOP เปลี่ยนสีตามสถานะ Toggle
task.spawn(function()
    while true do
        if HighlightEnabled then
            -- เปลี่ยนสี
            local t = tick()
            local color = Color3.fromHSV((t % 5) / 5, 1, 1)

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character then
                    local h = plr.Character:FindFirstChild("Highlight_Rainbow") or CreateHighlight(plr.Character)
                    h.FillColor = color
                    h.OutlineColor = color
                end
            end

        else
            -- ปิด = ลบ highlight ทั้งหมด
            RemoveAllHighlights()
        end

        task.wait(Speed)
    end
end)


