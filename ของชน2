Tab:Button({
    Title = "bypass hitbox",
    Locked = false,
    Callback = function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/pppp570/Roblox/refs/heads/main/%E0%B8%82%E0%B8%AD%E0%B8%87%E0%B9%81%E0%B8%AD%E0%B8%94%E0%B8%A1%E0%B8%B4%E0%B8%99%E0%B9%82%E0%B8%A3", true))()
    end
})

_G.ESPEnabled = false
_G.HeadSize = 20
_G.VisualColor = Color3.fromRGB(255, 0, 0)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function ApplyHitbox()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            pcall(function()
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
                    hrp.Transparency = 0.7
                    hrp.Material = Enum.Material.Neon
                    hrp.Color = _G.VisualColor
                    hrp.CanCollide = false
                end
            end)
        end
    end
end

local function ResetHitbox()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            pcall(function()
                local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.Material = Enum.Material.Plastic
                end
            end)
        end
    end
end

task.spawn(function()
    while task.wait(0.15) do
        if _G.ESPEnabled then
            ApplyHitbox()
        end
    end
end)


Tab:Toggle({
    Title = "hitbox",
    Default = false,
    Callback = function(state)
        _G.ESPEnabled = state
        if state then
            ApplyHitbox()
        else
            ResetHitbox()
        end
    end
})

Tab:Slider({
    Title = "Hitbox Size",
    Step = 1,
    Value = {
        Min = 5,
        Max = 100,
        Default = _G.HeadSize,
    },
    Callback = function(value)
        _G.HeadSize = value
        if _G.ESPEnabled then
            ApplyHitbox()
        end
    end
})

Tab:Colorpicker({
    Title = "Color",
    Default = _G.VisualColor,
    Transparency = 0,
    Callback = function(color)
        _G.VisualColor = color
        if _G.ESPEnabled then
            ApplyHitbox()
        end
    end
})
