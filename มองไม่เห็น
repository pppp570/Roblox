--==================================================
-- SERVICES
--==================================================
local Players = game:GetService("Players")
local player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================
local targetPosition = Vector3.new(1059.96, 98.00, 2606.17) -- ตำแหน่งที่วาป
local waitBeforeRespawn = 0.5 -- รอหลัง setfflag ก่อนรีตัว

--==================================================
-- ฟังก์ชันวาป
--==================================================
local function teleportToPosition(position)
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    root.CFrame = CFrame.new(position)
end

--==================================================
-- ฟังก์ชันรีตัวละคร
--==================================================
local function respawnCharacter()
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Health = 0 -- ทำให้รีตัว
        end
    end
end

--==================================================
-- รัน setfflag
--==================================================
local success, err = pcall(function()
    setfflag("NextGenReplicatorEnabledWrite4", "false")
    task.wait(1)
    setfflag("NextGenReplicatorEnabledWrite4", "true")
end)

if success then
    print("FFlag ถูกตั้งเรียบร้อยแล้ว")
else
    warn("เกิดข้อผิดพลาด: "..err)
end

--==================================================
-- วาปและรีตัวละคร
--==================================================
teleportToPosition(targetPosition)
task.wait(waitBeforeRespawn)
respawnCharacter()
