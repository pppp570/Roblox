	TweenInfo.new(0.8,Enum.EasingStyle.Quart),
	{Position = title.Position + UDim2.new(1,0,0,0)}
):Play()

for _,text in pairs(labels) do
	TweenService:Create(
		text,
		TweenInfo.new(0.8,Enum.EasingStyle.Quart),
		{Position = text.Position + UDim2.new(1,0,0,0)}
	):Play()
end

task.wait(1)

