bg.BackgroundTransparency = 1
bg.Parent = gui

-- โลโก้ (รูปภาพ)
local title = Instance.new("ImageLabel")
title.Size = UDim2.new(0,220,0,220)
title.Position = UDim2.new(0.5,-110,0.08,0)
title.BackgroundTransparency = 1
title.Image = "rbxassetid://125250695222888"
title.ScaleType = Enum.ScaleType.Fit
title.Parent = bg

-- แถบโหลด
local barBG = Instance.new("Frame")
barBG.Size = UDim2.new(0,300,0,8)
barBG.Position = UDim2.new(0.5,-150,1,-40) -- ล่างสุด
barBG.BackgroundColor3 = Color3.fromRGB(40,40,40)
barBG.BorderSizePixel = 0
barBG.Parent = bg

Instance.new("UICorner",barBG).CornerRadius = UDim.new(1,0)

local bar = Instance.new("Frame")
bar.Size = UDim2.new(0,0,1,0)
bar.BorderSizePixel = 0
bar.BackgroundColor3 = Color3.fromRGB(0,255,170)
bar.Parent = barBG

Instance.new("UICorner",bar).CornerRadius = UDim.new(1,0)

-- รายการโหลด
local tasks = {
"Initializing",
"Creating folders",
"Downloading assets",
"Preparing interface",
"Ready"
}

local labels = {}

for i,v in ipairs(tasks) do

	local y = 0.34 + (i*0.045)

	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(0,280,0,22)
	text.Position = UDim2.new(0.5,-140,y,0)
	text.BackgroundTransparency = 1
	text.Text = "○  "..v
	text.Font = Enum.Font.GothamMedium
	text.TextSize = 16
	text.TextColor3 = Color3.fromRGB(170,170,170)
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.Parent = bg
	
	table.insert(labels,text)

	-- เส้นลอย
	local line = Instance.new("Frame")
	line.Size = UDim2.new(0,240,0,1)
	line.Position = UDim2.new(-0.3,0,y + 0.028,0)
	line.BackgroundColor3 = Color3.fromRGB(80,80,80)
	line.BorderSizePixel = 0
	line.Parent = bg

	task.spawn(function()
		while line.Parent do

			line.Position = UDim2.new(-0.3,0,line.Position.Y.Scale,0)

			local tween = TweenService:Create(
				line,
				TweenInfo.new(3 + math.random(),Enum.EasingStyle.Linear),
				{Position = UDim2.new(1.2,0,line.Position.Y.Scale,0)}
			)

			tween:Play()
			tween.Completed:Wait()

		end
	end)

end

-- โหลดทีละอัน
for i,v in ipairs(labels) do

	task.wait(0.8)

	local tween = TweenService:Create(
		v,
		TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
		{TextColor3 = Color3.fromRGB(0,255,170)}
	)

	tween:Play()
	tween.Completed:Wait()

	v.Text = "✓  "..tasks[i]

	local size = i/#labels

	TweenService:Create(
		bar,
		TweenInfo.new(0.5,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
		{Size = UDim2.new(size,0,1,0)}
	):Play()

end

task.wait(0.7)

-- เลื่อนออก
TweenService:Create(
