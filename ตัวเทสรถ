})
local speed = 50 -- ค่าเริ่มต้น
local enabled = false

-- Input ใส่ความเร็ว
local Input = Tab:Input({
    Title = "Speed",
    Value = "50",
    InputIcon = "gauge",
    Type = "Input",
    Placeholder = "Enter speed...",
    Callback = function(input)
        local num = tonumber(input)
        if num then
            speed = num
            print("Speed set to: "..speed)
        end
    end
})

-- Toggle เปิด/ปิด
local Toggle = Tab:Toggle({
    Title = "Speed Boost",
    Icon = "zap", -- optional
    Default = false,
    Callback = function(state)
        enabled = state
        
        if state then
            print("เปิดความเร็ว")

            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                
                local bv = Instance.new("BodyVelocity")
                bv.Name = "SpeedVelocity"
                bv.MaxForce = Vector3.new(100000,0,100000)
                bv.Parent = char.HumanoidRootPart

                task.spawn(function()
                    while enabled and bv.Parent do
                        local hrp = char.HumanoidRootPart
                        bv.Velocity = hrp.CFrame.LookVector * speed
                        task.wait()
                    end
                end)

            end

        else
            print("ปิดความเร็ว")

            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local old = char.HumanoidRootPart:FindFirstChild("SpeedVelocity")
                if old then
                    old:Destroy()
                end
            end
        end
    end
})
local Button = Tab:Button({
    Title = "Discord",
    Locked = false,
    Callback = function()
        local text = "https://discord.gg/zgEKm7Z9Xy"

        if setclipboard then
            setclipboard(text)
            print("คัดลอกแล้ว")
        else
            warn("Executor ไม่รองรับ setclipboard")
        end
    end
})

local text = "Discord"

task.spawn(function()
    local offset = 0
    while true do
        offset = offset + 0.05
        local rich = ""

        for i = 1, #text do
            local hue = (offset + (i * 0.1)) % 1
            local color = Color3.fromHSV(hue,1,1)

            rich = rich .. string.format(
                "<font color='rgb(%d,%d,%d)'>%s</font>",
                color.R*255,
                color.G*255,
                color.B*255,
                text:sub(i,i)
            )
        end

        Button:SetTitle(rich)
        task.wait(0.05)
    end
end)

