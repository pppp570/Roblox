local Toggle = Tab:Toggle({
    Title = "ESP Players",
    Desc = "กดเพื่อแสดงหรือซ่อนเส้นถึงผู้เล่นอื่น",
    Default = false,
    Callback = function(State)
        _G.ESPEnabled = State

        if State then
            WindUI:Notify({
                Title = "ESP ",
                Content = "✅ เปิดใช้งานแล้ว",
                Duration = 2,
                Icon = "eye",
            })

            -- เก็บเส้นไว้เพื่อปิดตอนหยุด
            _G.Lines = {}

            task.spawn(function()
                while _G.ESPEnabled do
                    task.wait(0.1)

                    -- ลบเส้นเก่าออกก่อนจะสร้างใหม่
                    for _, line in pairs(_G.Lines) do
                        if line and line.Remove then
                            pcall(function() line:Remove() end)
                        end
                    end
                    _G.Lines = {}

                    -- สร้างเส้นใหม่ทั้งหมด
                    for _, v in pairs(game.Players:GetPlayers()) do
                        if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                            local line = Drawing.new("Line")
                            table.insert(_G.Lines, line)

                            local myHRP = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local targetHRP = v.Character.HumanoidRootPart
                            if myHRP and targetHRP then
                                local myPos, onScreen1 = workspace.CurrentCamera:WorldToViewportPoint(myHRP.Position)
                                local targetPos, onScreen2 = workspace.CurrentCamera:WorldToViewportPoint(targetHRP.Position)
                                if onScreen1 and onScreen2 then
                                    line.From = Vector2.new(myPos.X, myPos.Y)
                                    line.To = Vector2.new(targetPos.X, targetPos.Y)
                                    line.Visible = true
                                    line.Color = Color3.fromRGB(R, G, B)
                                    line.Thickness = 2
                                else
                                    line.Visible = false
                                end
                            end
                        end
                    end
                end

                -- ถ้าปิด ESP ให้ลบเส้นทั้งหมดออก
                for _, line in pairs(_G.Lines) do
                    if line and line.Remove then
                        pcall(function() line:Remove() end)
                    end
                end
                _G.Lines = {}

                WindUI:Notify({
                    Title = "ESP ",
                    Content = "⛔ ปิดใช้งานแล้ว",
                    Duration = 2,
                    Icon = "x-circle",
                })
            end)

        else
            -- ปิด ESP
            _G.ESPEnabled = false
        end
    end
})
