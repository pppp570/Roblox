local Tab = Window:Tab({
Title = "ฟาม",
Icon = "axe",
Locked = false,
})
-- ⚙️ ตั้งค่าพื้นฐาน
_G.AutoFarm = false
_G.AutoFarmDelayBeforePress = 0.5 -- หน่วงเวลาก่อนกด (วินาที)
_G.AutoFarmDelayAfterPress = 2 -- หน่วงหลังเก็บเสร็จ (วินาที)

-- 🔢 ลำดับต้นมะม่วง
local mangoIndexes = {7, 5, 10, 8, 3, 6, 7, 4, 9}

-- 🧍 ตัวแปรหลัก
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- 🍋 ฟังก์ชันฟามมะม่วง
local function startAutoFarm()
    task.spawn(function()
        while _G.AutoFarm do
            local mangoFolder = workspace:FindFirstChild("Plants") and workspace.Plants:FindFirstChild("Mango")
            if not mangoFolder then
                task.wait(1)
                continue
            end

            for _, index in ipairs(mangoIndexes) do
                if not _G.AutoFarm then break end

                local plant = mangoFolder:GetChildren()[index]
                if plant then
                    local prompts = {}
                    for _, obj in pairs(plant:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            table.insert(prompts, obj)
                        end
                    end

                    if #prompts > 0 then
                        local mangoPart = plant:FindFirstChildWhichIsA("BasePart", true)
                        if mangoPart then
                            -- 🔹 วาปไปต้นนั้น
                            rootPart.CFrame = mangoPart.CFrame + Vector3.new(0, 3, 0)

                            -- ⏳ หน่วงเวลาก่อนกด (ค่าเริ่มต้น 2 วิ)
                            task.wait(_G.AutoFarmDelayBeforePress)

                            -- 🖱️ กดเก็บผลมะม่วง
                            for _, prompt in ipairs(prompts) do
                                pcall(fireproximityprompt, prompt)
                            end

                            -- ⌛ หน่วงหลังเก็บเสร็จ (ค่าเริ่มต้น 3 วิ)
                            task.wait(_G.AutoFarmDelayAfterPress)
                        end
                    end
                end

                task.wait(0.1)
            end
        end
    end)
end

-- ✅ Toggle ควบคุม
local Toggle = Tab:Toggle({
    Title = "ฟามมะม่วง",
    Desc = "ถือตะกล้าก่อนเปิด",
    Default = false,
    Callback = function(state)
        _G.AutoFarm = state
        if state then
            print("✅ เริ่มฟาร์มมะม่วงแล้ว")
            WindUI:Notify({
                Title = "ฟามมะม่วง",
                Content = "🍋 เริ่มทำงาน",
                Duration = 2,
                Icon = "check-circle",
            })
            startAutoFarm()
        else
            print("⛔ หยุดฟาร์มมะม่วงแล้ว")
            WindUI:Notify({
                Title = "AutoFarm มะม่วง",
                Content = "⛔ หยุดทำงาน",
                Duration = 2,
                Icon = "x-circle",
            })
        end
    end
})
