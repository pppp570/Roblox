                            if part then  
                                humanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)  
                                task.wait(0.2) -- รอก่อนกด  
                                for _, prompt in ipairs(prompts) do  
                                    pcall(fireproximityprompt, prompt)  
                                end  
                                -- ✅ หลังจากกดเสร็จ รออยู่ตรงนั้น 3 วิ  
                                task.wait(2)  
                            end  
                        end  
                    end  
                    task.wait(0.1)  
                end  
                task.wait(0.1)  
            end  
        end)  
    else  
        print("❌ ปิดฟาร์มวัวแล้ว")  
        _G.AutoCow = false  
    end  
end

