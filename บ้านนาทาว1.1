-- 🟢 Toggle ESP Highlight
local Toggle = Tab:Toggle({
    Title = "ESP Highlight",
    Desc = "เรืองแสงรอบผู้เล่นทั้งหมด",
    Default = false,
    Callback = function(State)
        _G.HighlightESP = State

        if State then
            WindUI:Notify({
                Title = "Highlight ESP",
                Content = "✅ เปิดใช้งานแล้ว",
                Duration = 2,
                Icon = "eye",
            })

            -- ฟังก์ชันสร้าง Highlight
            local function addHighlight(plr)
                if plr == game.Players.LocalPlayer then return end
                if not plr.Character then return end
                if plr.Character:FindFirstChild("Highlight") then return end

                local highlight = Instance.new("Highlight")
                highlight.Name = "Highlight"
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.FillColor = Color3.fromRGB(0, 255, 255) -- สีฟ้า
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Adornee = plr.Character
                highlight.Parent = plr.Character
            end

            -- ฟังก์ชันลบ Highlight
            local function removeHighlight(plr)
                if plr.Character and plr.Character:FindFirstChild("Highlight") then
                    plr.Character.Highlight:Destroy()
                end
            end

            -- เพิ่มให้ทุกคนที่มีอยู่แล้ว
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= game.Players.LocalPlayer then
                    addHighlight(p)
                end
            end

            -- เมื่อมีผู้เล่นใหม่เข้ามา
            game.Players.PlayerAdded:Connect(function(p)
                p.CharacterAdded:Connect(function()
                    task.wait(1)
                    if _G.HighlightESP then
                        addHighlight(p)
                    end
                end)
            end)

            -- ลูปตรวจทุก ๆ 1 วิ
            task.spawn(function()
                while _G.HighlightESP do
                    task.wait(1)
                    for _, p in pairs(game.Players:GetPlayers()) do
                        if p ~= game.Players.LocalPlayer then
                            if p.Character and not p.Character:FindFirstChild("Highlight") then
                                addHighlight(p)
                            end
                        end
                    end
                end

                -- ถ้าปิด ESP ให้ลบทั้งหมด
                for _, p in pairs(game.Players:GetPlayers()) do
                    removeHighlight(p)
                end

                WindUI:Notify({
                    Title = "Highlight ESP",
                    Content = "⛔ ปิดใช้งานแล้ว",
                    Duration = 2,
                    Icon = "x-circle",
                })
            end)

        else
            _G.HighlightESP = false
        end
    end
})
