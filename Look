-- WINDUI
--------------------------------------------------
local Window = WindUI:CreateWindow({
    Title = "so Hub",
    Author = "look",
    Folder = "AimLockUI",
    OpenButton = { Enabled = true }
})

local MainTab = Window:Tab({ Title = "Main" })

MainTab:Toggle({
    Title = "Enable AimLock",
    Default = AimEnabled,
    Callback = function(v)
        AimEnabled = v
    end
})

MainTab:Toggle({
    Title = "Show FOV",
    Default = ShowFOV,
    Callback = function(v)
        ShowFOV = v
    end
})

MainTab:Slider({
    Title = "FOV Radius",
    Value = {
        Min = 50,
        Max = 400,
        Default = FOVRadius
    },
    Callback = function(v)
        FOVRadius = v
        PreLockRadius = v * 1.4
    end
})

MainTab:Colorpicker({
    Title = "FOV Color",
    Default = FOVColor,
    Callback = function(c)
        FOVColor = c
    end
})

MainTab:Colorpicker({
    Title = "Aim Color",
    Default = AimColor,
    Callback = function(c)
        AimColor = c
        AimLine.Color = c
        TargetDot.Color = c
    end
})
