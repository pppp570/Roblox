local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- SETTINGS (คุมด้วย Toggle)
local ENABLE = false
local COLOR = Color3.new(1,1,1)
local THICKNESS = 2
local CORNER_SIZE = 6

local Boxes = {}

-- สร้างเส้นมุม 8 เส้น
local function createCorner()
	local lines = {}
	for i = 1, 8 do
		local l = Drawing.new("Line")
		l.Visible = false
		l.Color = COLOR
		l.Thickness = THICKNESS
		l.Transparency = 1
		table.insert(lines, l)
	end
	return lines
end

local function removeESP(plr)
	if Boxes[plr] then
		for _, l in ipairs(Boxes[plr]) do
			l:Remove()
		end
		Boxes[plr] = nil
	end
end

-- Player handler
for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= LocalPlayer then
		Boxes[plr] = createCorner()
	end
end

Players.PlayerAdded:Connect(function(plr)
	if plr ~= LocalPlayer then
		Boxes[plr] = createCorner()
	end
end)

Players.PlayerRemoving:Connect(removeESP)

-- UPDATE
RunService.RenderStepped:Connect(function()
	if not ENABLE then
		for _, box in pairs(Boxes) do
			for _, l in ipairs(box) do
				l.Visible = false
			end
		end
		return
	end

	for plr, box in pairs(Boxes) do
		local char = plr.Character
		local hum = char and char:FindFirstChild("Humanoid")

		if char and hum and hum.Health > 0 then
			local cf, size = char:GetBoundingBox()

			local points = {}
			for x = -1, 1, 2 do
				for y = -1, 1, 2 do
					for z = -1, 1, 2 do
						local world = cf * Vector3.new(
							size.X/2 * x,
							size.Y/2 * y,
							size.Z/2 * z
						)
						local screen, vis = Camera:WorldToViewportPoint(world)
						if not vis then
							points = nil
							break
						end
						table.insert(points, Vector2.new(screen.X, screen.Y))
					end
				end
			end

			if points then
				local minX, minY = math.huge, math.huge
				local maxX, maxY = -math.huge, -math.huge

				for _, p in ipairs(points) do
					minX = math.min(minX, p.X)
					minY = math.min(minY, p.Y)
					maxX = math.max(maxX, p.X)
					maxY = math.max(maxY, p.Y)
				end

				local tl = Vector2.new(minX, minY)
				local tr = Vector2.new(maxX, minY)
				local bl = Vector2.new(minX, maxY)
				local br = Vector2.new(maxX, maxY)

				local lines = {
					{tl, tl + Vector2.new(CORNER_SIZE,0)},
					{tl, tl + Vector2.new(0,CORNER_SIZE)},
					{tr, tr + Vector2.new(-CORNER_SIZE,0)},
					{tr, tr + Vector2.new(0,CORNER_SIZE)},
					{bl, bl + Vector2.new(CORNER_SIZE,0)},
					{bl, bl + Vector2.new(0,-CORNER_SIZE)},
					{br, br + Vector2.new(-CORNER_SIZE,0)},
					{br, br + Vector2.new(0,-CORNER_SIZE)},
				}

				for i, l in ipairs(box) do
					l.From = lines[i][1]
					l.To = lines[i][2]
					l.Visible = true
				end
			else
				for _, l in ipairs(box) do
					l.Visible = false
				end
			end
		else
			for _, l in ipairs(box) do
				l.Visible = false
			end
		end
	end
end)

