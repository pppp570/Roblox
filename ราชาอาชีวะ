local function flyToAndPress(obj)

    if not obj then return end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if not prompt then return end

    local target = obj.Position + Vector3.new(0,3,0)

    while (hrp.Position - target).Magnitude > 2 do
        if not ToggleState then return end
        local dir = (target - hrp.Position).Unit
        hrp.CFrame = hrp.CFrame + dir * 3
        RunService.Heartbeat:Wait()
    end

    local startTime = tick()

    while tick() - startTime < 6 do
        if not ToggleState then return end
        prompt:InputHoldBegin()
        RunService.Heartbeat:Wait()
    end

    prompt:InputHoldEnd()

    local waitTime = 0

    while waitTime < 4 do
        if not ToggleState then return end
        task.wait(0.1)
        waitTime = waitTime + 0.1
    end

end

spawn(function()
    while true do
        if ToggleState then
            for _, obj in ipairs(promptObjects) do
                flyToAndPress(obj)
            end
        else
            task.wait(0.2)
        end
    end
end)



local LocalPlayer = Players.LocalPlayer
local NoclipConnection = nil
local Clip = true

local function startNoclip()

	if NoclipConnection then return end

	Clip = false

	NoclipConnection = RunService.Stepped:Connect(function()

		local char = LocalPlayer.Character

		if char and not Clip then
			for _, v in pairs(char:GetDescendants()) do
				if v:IsA("BasePart") then
					v.CanCollide = false
				end
			end
		end

	end)

end

local function stopNoclip()

	Clip = true

	if NoclipConnection then
		NoclipConnection:Disconnect()
		NoclipConnection = nil
	end

	local char = LocalPlayer.Character

	if char then
		for _, v in pairs(char:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = true
			end
		end
	end

end

local Toggle = Tab:Toggle({
	Title = "Noclip",
	Icon = "check-line",
	Type = "Checkbox",
	Value = false,
	Callback = function(state)
		if state then
			startNoclip()
		else
			stopNoclip()
		end
	end
})


