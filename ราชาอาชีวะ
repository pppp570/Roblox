local function startFarm()

    task.spawn(function()

        while running do

            for _,i in ipairs(targets) do
                if not running then break end

                local obj = folder:GetChildren()[i]
                if obj and obj:FindFirstChild("Hold E") then
                    
                    local prompt = obj["Hold E"]
                    local target = prompt.Parent.Position + Vector3.new(0,3,0)

                    while running and (hrp.Position - target).Magnitude > 3 do
                        local dir = (target - hrp.Position).Unit
                        hrp.CFrame = hrp.CFrame + dir * 3
                        RunService.Heartbeat:Wait()
                    end

                    repeat
                        if not running then break end
                        prompt:InputHoldBegin()
                        task.wait(0.7)
                        prompt:InputHoldEnd()
                        task.wait(0.7)
                    until not prompt.Enabled

                    task.wait(3)
                end
            end

        end

    end)

end

