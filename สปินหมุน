```lua
-- เอาไปรันเลยเหี้ย  กดปุ่ม X เพื่อเปิด/ปิด  ไซเลนเอมเวอร์ชั่นคมกริบ
-- ปรับให้ยิงทะลุผนังได้ แถมชดเชยปิงแบบจัดเต็ม
-- ถ้าไม่โดนอีกให้เอาไปตบกระบาลตัวเอง

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- หา Remote ที่ใช้ยิง
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SendRemote = Remotes:WaitForChild("Send")

-- ตัวแปรสถานะ
local silentAim = false
local fovRadius = 120
local aimTarget = nil

-- FOV Circle (Drawing)
local fovCircle
if not UserInputService.TouchEnabled then
	local segs = 32
	fovCircle = {}
	fovCircle.lines = {}
	for i = 1, segs do
		local line = Drawing.new("Line")
		line.Visible = false
		line.Thickness = 1.5
		line.Color = Color3.fromRGB(255, 255, 255)
		fovCircle.lines[i] = line
	end
	fovCircle.segments = segs
	fovCircle.Visible = false
end

-- ── ระบบทำนายตำแหน่ง (ฉบับอัพเกรด) ──
local historySize = 15
local posHistory = {}

-- เก็บ history
RunService.Heartbeat:Connect(function()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChild("Humanoid")
			if root and hum and hum.Health > 0 then
				if not posHistory[player] then posHistory[player] = {} end
				table.insert(posHistory[player], { time = os.clock(), pos = root.Position })
				if #posHistory[player] > historySize then
					table.remove(posHistory[player], 1)
				end
			else
				posHistory[player] = nil
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(p) posHistory[p] = nil end)

local function getVelocity(player)
	local hist = posHistory[player]
	if not hist or #hist < 2 then return Vector3.new() end
	-- ถ่วงน้ำหนักตามลำดับ (ล่าสุดสำคัญกว่า)
	local sum, totalWeight = Vector3.new(), 0
	for i = 2, #hist do
		local dt = hist[i].time - hist[i-1].time
		if dt > 0 then
			local v = (hist[i].pos - hist[i-1].pos) / dt
			local w = i * 1.2  -- bias ล่าสุด
			sum = sum + v * w
			totalWeight = totalWeight + w
		end
	end
	if totalWeight == 0 then return Vector3.new() end
	return sum / totalWeight
end

local function predictPos(head, root, player)
	if not head then return Vector3.zero end
	local vel = getVelocity(player)
	local ping = math.clamp((select(1, pcall(function() return LocalPlayer:GetNetworkPing() end)) or 0.1), 0.05, 0.3)

	-- ความเร็วแนวราบ
	local hSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude

	-- Multiplier ปรับตามปิงและความเร็ว (คมกว่าเดิม)
	local mult
	if ping > 0.15 then
		mult = 1.6 + (hSpeed / 100) * 0.4
	elseif ping > 0.1 then
		mult = 1.35 + (hSpeed / 100) * 0.3
	else
		mult = 1.15 + (hSpeed / 100) * 0.2
	end

	local horizontal = Vector3.new(vel.X, 0, vel.Z) * ping * mult

	-- แนวตั้ง: ปรับให้กระโดดแล้วไม่เพี้ยน
	local vertical = Vector3.new(0, math.clamp(vel.Y * ping * 0.4, -6, 6), 0)

	-- ถ้าอยู่กลางอากาศเพิ่ม boost
	local jumpBoost = Vector3.new(0, vel.Y > 15 and 0.7 or vel.Y > 8 and 0.4 or 0, 0)

	-- offset หัวเผื่อคนวิ่ง
	local headOff = Vector3.new(0, hSpeed > 35 and 0.18 or hSpeed > 20 and 0.12 or 0.05, 0)

	return head.Position + horizontal + vertical + jumpBoost + headOff
end

-- ── หาเป้าหมายใกล้ FOV ──
local function getClosest()
	local best, bestDist = nil, fovRadius
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local head = player.Character:FindFirstChild("Head")
			local hum = player.Character:FindFirstChild("Humanoid")
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if head and hum and root and hum.Health > 0 then
				local pos, vis = Camera:WorldToViewportPoint(head.Position)
				if vis then
					local screen = Vector2.new(pos.X, pos.Y)
					local dist = (screen - center).Magnitude
					if dist <= bestDist then
						bestDist = dist
						best = player
					end
				end
			end
		end
	end
	return best
end

-- ── Hook FireServer ──
local oldFire
pcall(function()
	oldFire = hookfunction(SendRemote.FireServer, function(self, ...)
		if not silentAim or self ~= SendRemote then
			return oldFire(self, ...)
		end
		local args = { ... }
		-- args[2] น่าจะเป็น action (ในเกมนี้ใช้ "shoot_gun")
		if args[2] == "shoot_gun" and aimTarget then
			local char = aimTarget.Character
			if char then
				local head = char:FindFirstChild("Head")
				local root = char:FindFirstChild("HumanoidRootPart")
				local hum = char:FindFirstChild("Humanoid")
				if head and root and hum and hum.Health > 0 then
					local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
					if myHead then
						local aimPos = predictPos(head, root, aimTarget)
						local origin = myHead.Position
						-- ไม่สนกำแพง ยิงพุ่งเลย
						args[4] = CFrame.new(origin, aimPos)
						args[5] = {[1] = {[1] = {Instance = head, Normal = Vector3.new(0,1,0), Position = aimPos}}}
					end
				end
			end
		end
		return oldFire(self, unpack(args))
	end)
end)

-- ── อัปเดตเป้าหมายทุก RenderStep ──
RunService.RenderStepped:Connect(function()
	pcall(function()
		aimTarget = silentAim and getClosest() or nil

		-- วาด FOV
		if fovCircle then
			local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
			local t = tick()
			for i = 1, fovCircle.segments do
				local a1 = math.rad((i-1) * (360/fovCircle.segments))
				local a2 = math.rad(i * (360/fovCircle.segments))
				fovCircle.lines[i].From = center + Vector2.new(math.cos(a1)*fovRadius, math.sin(a1)*fovRadius)
				fovCircle.lines[i].To = center + Vector2.new(math.cos(a2)*fovRadius, math.sin(a2)*fovRadius)
				-- สีรุ้งสวยๆ
				fovCircle.lines[i].Color = Color3.fromHSV(((i/fovCircle.segments) + t*0.5)%1,1,1)
				fovCircle.lines[i].Visible = silentAim
			end
		end
	end)
end)

-- ── UI ง่ายๆ (กด X เปิด/ปิด, Scroll ปรับ FOV) ──
local gui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
gui.Name = "SilentAimUI"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 40)
frame.Position = UDim2.new(0.8, -100, 0, 50)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 0

local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, 0, 1, 0)
btn.BackgroundTransparency = 1
btn.TextColor3 = Color3.fromRGB(255,255,255)
btn.Text = "Silent Aim [OFF]"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14

local dragging
btn.MouseButton1Click:Connect(function()
	silentAim = not silentAim
	btn.Text = silentAim and "Silent Aim [ON]" or "Silent Aim [OFF]"
	btn.TextColor3 = silentAim and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)
end)

-- ปรับ FOV ด้วย Scroll (ต้องชี้ไปที่ frame)
frame.MouseButton1Down:Connect(function()
	dragging = true
	while dragging do
		task.wait()
		if dragging then
			local delta = UserInputService:GetMouseDelta()
			fovRadius = math.clamp(fovRadius + delta.Y * 0.5, 30, 500)
		end
	end
end)
UserInputService.InputEnded:Connect(function(input, gp)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- กด X เพื่อ toggle (สำรอง)
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.X then
		silentAim = not silentAim
		btn.Text = silentAim and "Silent Aim [ON]" or "Silent Aim [OFF]"
		btn.TextColor3 = silentAim and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)
	end
end)

-- แสดง FOV radius (อัปเดตทุกวินาที)
spawn(function()
	while task.wait(1) do
		frame:FindFirstChildOfClass("TextButton").Text = string.format("%s | FOV: %.0f", silentAim and "ON" or "OFF", fovRadius)
	end
end)

print("โหลด Silent Aim คมกริบแล้ว กด X เปิดเลยมหา'ลัย")
