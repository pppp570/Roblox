getgenv().slientaimbyx2nyx = false
getgenv().FOVSize = 400

local L = {
P = game:GetService("Players"),
RS = game:GetService("ReplicatedStorage"),
RunService = game:GetService("RunService"),
Cam = workspace.CurrentCamera
}

L.LP = L.P.LocalPlayer
L.Lib = require(L.RS:WaitForChild("WeaponsSystem"):WaitForChild("Libraries"):WaitForChild("BaseWeapon"))

-- FOV Circle
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(255,255,255)
FOVCircle.Thickness = 1
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Visible = false

-- Snap Line
local SnapLine = Drawing.new("Line")
SnapLine.Color = Color3.fromRGB(255,0,0)
SnapLine.Thickness = 1.5
SnapLine.Visible = false

-- หาเป้าหมาย
L.getT = function()
L.res, L.d = nil, getgenv().FOVSize
for _,v in pairs(L.P:GetPlayers()) do
if v ~= L.LP and v.Character and v.Character:FindFirstChild("Head") then
local h = v.Character:FindFirstChildOfClass("Humanoid")
if h and h.Health > 0 then
local p,vv = L.Cam:WorldToViewportPoint(v.Character.Head.Position)
local m = (Vector2.new(p.X,p.Y) - (L.Cam.ViewportSize/2)).Magnitude
if vv and m < L.d then
L.res = v.Character.Head
L.d = m
end
end
end
end
return L.res
end

-- Render
L.RunService.RenderStepped:Connect(function()

FOVCircle.Position = Vector2.new(L.Cam.ViewportSize.X/2, L.Cam.ViewportSize.Y/2)  
FOVCircle.Radius = getgenv().FOVSize  
FOVCircle.Visible = getgenv().slientaimbyx2nyx  

local target = L.getT()  

if getgenv().slientaimbyx2nyx and target then  
    local screenPos,onScreen = L.Cam:WorldToViewportPoint(target.Position)  

    if onScreen then  
        SnapLine.From = Vector2.new(L.Cam.ViewportSize.X/2,L.Cam.ViewportSize.Y/2)  
        SnapLine.To = Vector2.new(screenPos.X,screenPos.Y)  
        SnapLine.Visible = true  
    else  
        SnapLine.Visible = false  
    end  
else  
    SnapLine.Visible = false  
end

end)

-- hook ยิง
L.old = L.Lib.fire
L.Lib.fire = function(self,origin,dir,charge)
local target = getgenv().slientaimbyx2nyx and L.getT() or nil
local newDir = target and (target.Position-origin).Unit or dir
return L.old(self,origin,newDir,charge)
end

