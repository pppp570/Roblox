local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local flying = false
local bg
local bv
local flyConn
local noclipConn

local speed = 60

local function startFly()
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")

bg = Instance.new("BodyGyro")
bg.P = 9e4
bg.MaxTorque = Vector3.new(9e9,9e9,9e9)
bg.CFrame = root.CFrame
bg.Parent = root

bv = Instance.new("BodyVelocity")
bv.MaxForce = Vector3.new(9e9,9e9,9e9)
bv.Velocity = Vector3.new()
bv.Parent = root

flyConn = RunService.RenderStepped:Connect(function()
if not flying then return end

local cam = workspace.CurrentCamera  
local moveDir = hum.MoveDirection  

if moveDir.Magnitude > 0 then  
    bv.Velocity = moveDir * speed  
else  
    bv.Velocity = Vector3.new()  
end  

bg.CFrame = cam.CFrame

end)

noclipConn = RunService.Stepped:Connect(function()
if player.Character then
for _,v in pairs(player.Character:GetDescendants()) do
if v:IsA("BasePart") then
v.CanCollide = false
end
end
end
end)

end

local function stopFly()
if flyConn then
flyConn:Disconnect()
flyConn = nil
end

if noclipConn then
noclipConn:Disconnect()
noclipConn = nil
end

if bg then
bg:Destroy()
bg = nil
end

if bv then
bv:Destroy()
bv = nil
end

end

local Toggle = Tab:Toggle({
Title = "Fly",
Icon = "plane",
Default = false,

Callback = function(state)
flying = state

if state then  
    startFly()  
else  
    stopFly()  
end

end

})

Toggle:Set(false)

local Tab = Window:Tab({
Title = "Esp",
Icon = "view", -- optional
Locked = false,
})
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local ESPEnabled = false
local ESPObjects = {}

-- สี
local lineColor = Color3.fromRGB(255,255,255) -- เส้นสีขาว
local boxOutline = Color3.fromRGB(255,255,255) -- ขอบสีขาว
local tone1 = Color3.fromRGB(170,0,255) -- ทูโทนสีที่1
local tone2 = Color3.fromRGB(80,0,120) -- ทูโทนสีที่2

local function CreateESP(player)

if player == LocalPlayer then return end  

local line = Drawing.new("Line")  
line.Thickness = 2  
line.Color = lineColor  
line.Visible = false  

local box = Drawing.new("Square")  
box.Thickness = 2  
box.Color = boxOutline  
box.Filled = false  
box.Visible = false  

local fill = Drawing.new("Square")  
fill.Thickness = 0  
fill.Color = tone1  
fill.Filled = true  
fill.Transparency = 0.5  
fill.Visible = false  

local fill2 = Drawing.new("Square")  
fill2.Thickness = 0  
fill2.Color = tone2  
fill2.Filled = true  
fill2.Transparency = 0.5  
fill2.Visible = false  

ESPObjects[player] = {line,box,fill,fill2}  

RunService.RenderStepped:Connect(function()  

    if not ESPEnabled then  
        line.Visible = false  
        box.Visible = false  
        fill.Visible = false  
        fill2.Visible = false  
        return  
    end  

    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Head") then  

        local root = player.Character.HumanoidRootPart  
        local head = player.Character.Head  

        local rootPos, visible = Camera:WorldToViewportPoint(root.Position)  
        local headPos = Camera:WorldToViewportPoint(head.Position)  

        if visible then  

            local distance = (Camera.CFrame.Position - root.Position).Magnitude  
            local size = math.clamp(3000 / distance,20,300)  

            local width = size/2  
            local height = size  

            local x = rootPos.X - width/2  
            local y = rootPos.Y - height/2  

            -- กล่อง  
            box.Size = Vector2.new(width,height)  
            box.Position = Vector2.new(x,y)  
            box.Visible = true  

            -- ทูโทนบน  
            fill.Size = Vector2.new(width,height/2)  
            fill.Position = Vector2.new(x,y)  
            fill.Visible = true  

            -- ทูโทนล่าง  
            fill2.Size = Vector2.new(width,height/2)  
            fill2.Position = Vector2.new(x,y + height/2)  
            fill2.Visible = true  

            -- เส้นไปหัว  
            line.From = Vector2.new(Camera.ViewportSize.X/2,0)  
            line.To = Vector2.new(headPos.X,headPos.Y)  
            line.Visible = true  

        else  
            line.Visible = false  
            box.Visible = false  
            fill.Visible = false  
            fill2.Visible = false  
        end  

    else  
        line.Visible = false  
        box.Visible = false  
        fill.Visible = false  
        fill2.Visible = false  
    end  

end)

end

for _,v in pairs(Players:GetPlayers()) do
CreateESP(v)
end

Players.PlayerAdded:Connect(CreateESP)

