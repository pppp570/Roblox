-- ฟังก์ชันบิน/ลอยไปยังเป้าหมาย
local function flyTo(position, speed)
    speed = speed or 100 -- ความเร็ว
    local reached = false
    local conn
    conn = RunService.Heartbeat:Connect(function(deltaTime)
        local direction = position - rootPart.Position
        local distance = direction.Magnitude
        if distance < 2 then
            reached = true
            conn:Disconnect()
        else
            rootPart.CFrame = rootPart.CFrame + direction.Unit * speed * deltaTime
        end
    end)
    repeat task.wait() until reached
end

